29.93.09.176.157.419.193.864.006.073.01.15.014.23h1.752a10.24 10.24 0 0 0-.022-.371c-.045-.554-.141-1.053-.378-1.518a3.879 3.879 0 0 0-1.694-1.694c-.465-.237-.964-.333-1.518-.378-.544-.044-1.216-.044-2.04-.044H11.3z" fill="currentColor"></path></svg></div><svg viewBox="0 0 32 32" fill="none" width="20" height="20" class="pointer-events-none absolute inset-0 m-0.5 invisible"><path d="M24.285 7.542a.878.878 0 0 1 1.22-.21.868.868 0 0 1 .21 1.214l-12 16.912a.877.877 0 0 1-1.415.02l-6-7.958a.868.868 0 0 1 .175-1.22.879.879 0 0 1 1.225.175l5.279 7L24.285 7.542z" fill="currentColor"></path></svg><div class="pointer-events-none absolute inset-0 m-0.5 opacity-0"><div class="relative inline-block overflow-hidden" style="width:20px;height:20px"></div></div></div></button></div></div></div></div></div></div></div><div data-message-item="true" data-message-id="22765833-1f87-457f-b416-91ee269e585f_7469576670734213581_assistant" class="mt-4 "><div data-slot="flexbox" class="min-h-0 min-w-0 flex flex-col gap-x-0 gap-y-0 shrink-0"><div class="w-full min-w-0"><div class="group/assistant-message relative min-w-0" data-testid="assistant-message" data-streaming-state="DONE" data-streaming-complete="true"><div class="mx-auto flex w-full max-w-3xl items-start gap-3 min-h-[26px]"><div class="-ms-1 flex shrink-0 items-center"><div class="" style="width:24px;height:24px" aria-hidden="true"></div></div><div class="min-w-0 flex-1"><div class="w-full min-w-0"></div></div></div><div class="mt-4"><div class="w-full min-w-0"><div class="min-w-0 space-y-6"><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><!--$?--><template id="B:1b"></template><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Python</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>import gradio as gr
import subprocess
import ffmpeg
import os
from faster_whisper import WhisperModel
from TTS.api import TTS
from transformers import MarianMTModel, MarianTokenizer

# Load model khi khởi động, mất 2 phút
print(&quot;Đang tải model AI...&quot;)
whisper_model = WhisperModel(&quot;small&quot;, device=&quot;cuda&quot;, compute_type=&quot;float16&quot;)
tts_model = TTS(&quot;tts_models/multilingual/multi-dataset/xtts_v2&quot;).to(&quot;cuda&quot;)

# Hàm dịch: EN -&gt; VI. Đổi cặp khác nếu cần
tokenizer = MarianTokenizer.from_pretrained(&quot;Helsinki-NLP/opus-mt-en-vi&quot;)
translate_model = MarianMTModel.from_pretrained(&quot;Helsinki-NLP/opus-mt-en-vi&quot;).to(&quot;cuda&quot;)
print(&quot;Tải xong!&quot;)

def translate_text(text):
    tokens = tokenizer(text, return_tensors=&quot;pt&quot;, padding=True).to(&quot;cuda&quot;)
    translated = translate_model.generate(**tokens)
    return tokenizer.decode(translated[0], skip_special_tokens=True)

def dub_video(input_video, target_lang):
    # Tên file tạm
    audio_ori = &quot;audio_ori.wav&quot;
    audio_dub = &quot;audio_dub.wav&quot;
    output_video = &quot;output.mp4&quot;

    # B1: Tách audio gốc
    ffmpeg.input(input_video).output(audio_ori).run(overwrite_output=True, quiet=True)

    # B2: Whisper ra text
    segments, _ = whisper_model.transcribe(audio_ori)
    text_ori = &quot; &quot;.join([seg.text for seg in segments])

    # B3: Dịch
    if target_lang == &quot;vi&quot;:
        text_trans = translate_text(text_ori) if any(ord(c) &lt; 128 for c in text_ori) else text_ori
    else:
        text_trans = text_ori # Tạm thời chỉ hỗ trợ EN-&gt;VI

    # B4: TTS clone giọng gốc
    tts_model.tts_to_file(text=text_trans, speaker_wav=audio_ori, language=target_lang, file_path=audio_dub)

    # B5: Ghép tiếng mới vào video, bỏ tiếng cũ
    video_input = ffmpeg.input(input_video)
    audio_input = ffmpeg.input(audio_dub)
    ffmpeg.output(video_input.video, audio_input.audio, output_video, vcodec=&#x27;copy&#x27;, acodec=&#x27;aac&#x27;).run(overwrite_output=True, quiet=True)

    return output_video, text_ori, text_trans

# Giao diện web
demo = gr.Interface(
    fn=dub_video,
    inputs=[
        gr.Video(label=&quot;1. Upload video MP4&quot;),
        gr.Dropdown(choices=[&quot;vi&quot;], value=&quot;vi&quot;, label=&quot;2. Chọn ngôn ngữ đích&quot;)
    ],
    outputs=[
        gr.Video(label=&quot;Video đã lồng tiếng&quot;),
        gr.Textbox(label=&quot;Lời thoại gốc&quot;),
        gr.Textbox(label=&quot;Bản dịch&quot;)
    ],
    title=&quot;HeyGen Clone - Web Riêng Của Bạn&quot;,
    description=&quot;Upload video tiếng Anh → Nhận video tiếng Việt, giữ nguyên giọng.&quot;
)
demo.launch()</code></pre></div></div><!--/$--></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><!--$?--><template id="B:1c"></template><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Code</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>faster-whisper==1.0.3
TTS==0.22.0
transformers==4.44.2
torch==2.3.1
ffmpeg-python==0.2.0
gradio==4.44.0</code></pre></div></div><!--/$--></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><!--$?--><template id="B:1d"></template><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Code</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>---
