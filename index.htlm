 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><!--$?--><template id="B:4c"></template><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">JavaScript</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>// pages/upload.js - 3 BƯỚC TIẾNG VIỆT
export default function Upload() {
  return (
    &lt;div style={{maxWidth:500,margin:&#x27;40px auto&#x27;,fontFamily:&#x27;system-ui&#x27;,padding:20}}&gt;
      &lt;h1 style={{textAlign:&#x27;center&#x27;}}&gt;Dịch Video Sang Tiếng Việt&lt;/h1&gt;
      
      {/* BƯỚC 1 */}
      &lt;div style={{background:&#x27;#f9fafb&#x27;,padding:20,borderRadius:12,marginBottom:20}}&gt;
        &lt;h3&gt;Bước 1: Chọn video&lt;/h3&gt;
        &lt;input type=&quot;file&quot; accept=&quot;video/*&quot; style={{width:&#x27;100%&#x27;,padding:10}}/&gt;
      &lt;/div&gt;

      {/* BƯỚC 2 */}
      &lt;div style={{background:&#x27;#f9fafb&#x27;,padding:20,borderRadius:12,marginBottom:20}}&gt;
        &lt;h3&gt;Bước 2: Chọn tiếng Việt&lt;/h3&gt;
        &lt;p&gt;Ngôn ngữ đích:&lt;/p&gt;
        &lt;select style={{width:&#x27;100%&#x27;,padding:12,fontSize:16}}&gt;
          &lt;option selected&gt;🇻🇳 Tiếng Việt&lt;/option&gt;
          &lt;option&gt;🇺🇸 Tiếng Anh&lt;/option&gt;
          &lt;option&gt;🇨🇳 Tiếng Trung&lt;/option&gt;
          &lt;option&gt;🇰🇷 Tiếng Hàn&lt;/option&gt;
        &lt;/select&gt;
        &lt;p style={{marginTop:10}}&gt;Giọng đọc:&lt;/p&gt;
        &lt;select style={{width:&#x27;100%&#x27;,padding:12}}&gt;
          &lt;option&gt;Nam miền Bắc&lt;/option&gt;
          &lt;option&gt;Nữ miền Bắc&lt;/option&gt;
          &lt;option&gt;Nam miền Nam&lt;/option&gt;
          &lt;option&gt;Nữ miền Nam&lt;/option&gt;
        &lt;/select&gt;
      &lt;/div&gt;

      {/* BƯỚC 3 */}
      &lt;div style={{background:&#x27;#f9fafb&#x27;,padding:20,borderRadius:12}}&gt;
        &lt;h3&gt;Bước 3: Bấm dịch&lt;/h3&gt;
        &lt;button style={{width:&#x27;100%&#x27;,padding:16,background:&#x27;#7c3aed&#x27;,color:&#x27;white&#x27;,border:0,borderRadius:8,fontSize:18,fontWeight:&#x27;bold&#x27;}}&gt;
          BẮT ĐẦU DỊCH NGAY
        &lt;/button&gt;
      &lt;/div&gt;
