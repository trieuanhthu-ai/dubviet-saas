eader\":true,\"cells\":[\"Ô còn thiếu\",\"Bạn điền gì\"],\"markdown_cells\":[{\"text\":\"Ô còn thiếu\",\"inline_entities\":null},{\"text\":\"Bạn điền gì\",\"inline_entities\":null}]},{\"is_header\":false,\"cells\":[\"**Space name**\",\"`heygen-clone`\",\"Viết liền, không dấu, không cách. VD: `dub-video-cua-toi`\"],\"markdown_cells\":[{\"text\":\"**Space name**\",\"inline_entities\":null},{\"text\":\"`heygen-clone`\",\"inline_entities\":null},{\"text\":\"Viết liền, không dấu, không cách. VD: `dub-video-cua-toi`\",\"inline_entities\":null}]},{\"is_header\":false,\"cells\":[\"**License**\",\"Bấm chọn `Apache License 2.0`\",\"Bấm vào ô chọn license\"],\"markdown_cells\":[{\"text\":\"**License**\",\"inline_entities\":null},{\"text\":\"Bấm chọn `Apache License 2.0`\",\"inline_entities\":null},{\"text\":\"Bấm vào ô chọn license\",\"inline_entities\":null}]}]},\"__isGenAIUnifiedResponseSectionViewModel\":\"GenAISingleLayoutViewModel\"},\"header\":null},{\"__typename\":\"GenAIUnifiedResponseSection\",\"view_model\":{\"__typename\":\"GenAISingleLayoutViewModel\",\"primitive\":{\"__typename\":\"GenAIMarkdownTextUXPrimitive\",\"__isGenAIUXPrimitive\":\"GenAIMarkdownTextUXPrimitive\",\"text\":\"\\r\\n\\r\\nĐiền 2 ô đó xong → Kéo xuống dưới cùng → Bấm nút xanh **`Tạo không gian`**\\r\\n\\r\\n### **Tóm tắt 3 click cuối**\\r\\n1. **Kéo lên trên** → Điền `Space name` = `heygen-clone`\\r\\n2. **Chọn License** = `Apache License 2.0` \\r\\n3. **Kéo xuống cuối** → Bấm `Tạo không gian`\\r\\n\\r\\nBấm `Tạo không gian` xong chụp màn hình tiếp cho mình. Mình chỉ bạn upload 3 file code là web chạy.\\r\\n\\r\\nBạn tìm thấy ô `Space name` chưa? Nó nằm ngay phía trên chỗ `Chọn SDK không gian` đó.\",\"inline_entities\":null,\"html_artifact_sandbox\":null},\"__isGenAIUnifiedResponseSectionViewModel\":\"GenAISingleLayoutViewModel\"},\"header\":null}],\"nested_responses\":null,\"footer_sections\":null,\"embedded_screens\":null,\"response_id\":\"9d9a1bf6-6942-4225-935a-e16342047d48\"},\"hasReceivedU