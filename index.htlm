 2.041.045.554.141 1.053.378 1.518.371.729.965 1.323 1.694 1.694.465.237.964.333 1.518.378.544.044 1.215.044 2.04.044H20.7c.826 0 1.497 0 2.041-.044.554-.045 1.053-.141 1.518-.378a3.879 3.879 0 0 0 1.694-1.694c.237-.465.333-.964.378-1.518.044-.544.044-1.215.044-2.04V15.8c0-.825 0-1.497-.044-2.041-.045-.554-.141-1.053-.378-1.518a3.879 3.879 0 0 0-1.694-1.694c-.465-.237-.964-.333-1.518-.378-.544-.045-1.215-.044-2.04-.044H17.3zm3.4 1.75c.855 0 1.443 0 1.9.038.445.037.688.103.865.193.4.204.725.53.929.93.09.176.157.418.193.864.037.457.038 1.045.038 1.9v6.4c0 .855 0 1.443-.038 1.9-.037.445-.103.688-.193.865-.204.4-.53.725-.93.929-.176.09-.418.157-.864.193-.457.037-1.045.038-1.9.038h-3.4c-.855 0-1.443 0-1.9-.038-.446-.037-.688-.103-.865-.193a2.126 2.126 0 0 1-.929-.93c-.09-.176-.156-.418-.193-.864-.037-.457-.038-1.045-.038-1.9v-6.4c0-.855 0-1.443.038-1.9.037-.446.103-.688.193-.865.204-.4.53-.725.93-.929.176-.09.418-.156.864-.193.457-.037 1.045-.038 1.9-.038h3.4z" fill="currentColor"></path><path d="M11.3 4.125c-.825 0-1.497 0-2.041.044-.554.045-1.053.141-1.518.378A3.879 3.879 0 0 0 6.047 6.24c-.237.465-.333.964-.378 1.518-.044.544-.044 1.215-.044 2.04V16.2c0 .826 0 1.497.044 2.041.045.554.141 1.053.378 1.518.371.729.965 1.323 1.694 1.694.465.237.964.333 1.518.378.117.01.241.016.37.021V20.1c-.08-.005-.156-.007-.229-.013-.445-.037-.688-.103-.865-.193a2.126 2.126 0 0 1-.929-.93c-.09-.176-.156-.418-.193-.864-.037-.457-.038-1.045-.038-1.9V9.8c0-.855 0-1.443.038-1.9.037-.445.103-.688.193-.865.204-.4.53-.725.93-.929.176-.09.419-.156.864-.193.457-.037 1.045-.038 1.9-.038h3.4c.855 0 1.443 0 1.9.038.445.037.688.103.865.193.4.204.725.53.929.93.09.176.157.419.193.864.006.073.01.15.014.23h1.752a10.24 10.24 0 0 0-.022-.371c-.045-.554-.141-1.053-.378-1.518a3.879 3.879 0 0 0-1.694-1.694c-.465-.237-.964-.333-1.518-.378-.544-.044-1.216-.044-2.04-.044H11.3z" fill="currentColor"></path></svg></div><svg viewBox="0 0 32 32" fill="none" width="20" height="20" class="pointer-events-none absolute inset-0 m-0.5 invisible"><path d="M24.285 7.542a.878.878 0 0 1 1.22-.21.868.868 0 0 1 .21 1.214l-12 16.912a.877.877 0 0 1-1.415.02l-6-7.958a.868.868 0 0 1 .175-1.22.879.879 0 0 1 1.225.175l5.279 7L24.285 7.542z" fill="currentColor"></path></svg><div class="pointer-events-none absolute inset-0 m-0.5 opacity-0"><div class="relative inline-block overflow-hidden" style="width:20px;height:20px"></div></div></div></button></div></div></div></div></div></div></div><div data-message-item="true" data-message-id="22765833-1f87-457f-b416-91ee269e585f_7469589085004690270_assistant" class="mt-4 "><div data-slot="flexbox" class="min-h-0 min-w-0 flex flex-col gap-x-0 gap-y-0 shrink-0"><div class="w-full min-w-0"><div class="group/assistant-message relative min-w-0" data-testid="assistant-message" data-streaming-state="DONE" data-streaming-complete="true"><div class="mx-auto flex w-full max-w-3xl items-start gap-3 min-h-[26px]"><div class="-ms-1 flex shrink-0 items-center"><div class="" style="width:24px;height:24px" aria-hidden="true"></div></div><div class="min-w-0 flex-1"><div class="w-full min-w-0"></div></div></div><div class="mt-4"><div class="w-full min-w-0"><div class="min-w-0 space-y-6"><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><!--$?--><template id="B:24"></template><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Python</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>import gradio as gr
import whisper
import torch
from TTS.api import TTS
import subprocess
import os
import tempfile
from pydub import AudioSegment

# Load models - dùng CPU vì Space bạn là CPU cơ bản
device = &quot;cuda&quot; if torch.cuda.is_available() else &quot;cpu&quot;
print(f&quot;Using device: {device}&quot;)

whisper_model = whisper.load_model(&quot;base&quot;)
tts = TTS(&quot;tts_models/multilingual/multi-dataset/xtts_v2&quot;).to(device)

def dub_video(video_path, target_language, progress=gr.Progress()):
    if video_path is None:
        raise gr.Error(&quot;Vui lòng upload video!&quot;)
    
    progress(0.1, desc=&quot;Đang tách audio khỏi video...&quot;)
    with tempfile.TemporaryDirectory() as tmpdir:
        audio_path = os.path.join(tmpdir, &quot;audio.wav&quot;)
        # Tách audio từ video
        subprocess.run([
            &quot;ffmpeg&quot;, &quot;-i&quot;, video_path, &quot;-vn&quot;, 
            &quot;-acodec&quot;, &quot;pcm_s16le&quot;, &quot;-ar&quot;, &quot;16000&quot;, &quot;-ac&quot;, &quot;1&quot;, 
            audio_path, &quot;-y&quot;
        ], check=True, capture_output=True)
        
        progress(0.3, desc=&quot;Đang nhận dạng giọng nói bằng Whisper...&quot;)
        # Whisper ASR + dịch
        result = whisper_model.transcribe(audio_path, task=&quot;translate&quot; if target_language==&quot;en&quot; else &quot;transcribe&quot;)
        translated_text = result[&quot;text&quot;]
        print(f&quot;Text: {translated_text}&quot;)
        
        progress(0.6, desc=&quot;Đang clone giọng và tạo audio mới...&quot;)
        output_audio = os.path.join(tmpdir, &quot;output.wav&quot;)
        # XTTS-v2 clone giọng từ audio gốc
        tts.tts_to_file(
            text=translated_text, 
            speaker_wav=audio_path, 
            language=target_language, 
            file_path=output_audio
        )
        
        progress(0.9, desc=&quot;Đang ghép audio vào video...&quot;)
        output_video = os.path.join(tmpdir, &quot;output.mp4&quot;)
        # Ghép audio mới vào video gốc, giữ lại hình
        subprocess.run([
            &quot;ffmpeg&quot;, &quot;-i&quot;, video_path, &quot;-i&quot;, output_audio, 
            &quot;-c:v&quot;, &quot;copy&quot;, &quot;-map&quot;, &quot;0:v:0&quot;, &quot;-map&quot;, &quot;1:a:0&quot;, 
            &quot;-shortest&quot;, output_video, &quot;-y&quot;
        ], check=True, capture_output=True)
        
        progress(1.0, desc=&quot;Hoàn thành!&quot;)
        return output_video

# Giao diện Gradio
demo = gr.Interface(
    fn=dub_video,
    inputs=[
        gr.Video(label=&quot;1. Upload Video cần lồng tiếng&quot;), 
        gr.Dropdown(
            choices=[&quot;vi&quot;, &quot;en&quot;, &quot;zh&quot;, &quot;ja&quot;, &quot;ko&quot;, &quot;fr&quot;, &quot;es&quot;, &quot;de&quot;], 
            value=&quot;vi&quot;, 
            label=&quot;2. Chọn ngôn ngữ đích&quot;
        )
    ],
    outputs=gr.Video(label=&quot;Video đã lồng tiếng xong&quot;),
    title=&quot;AI Dubbing Studio - HeyGen Clone Free&quot;,
    description=&quot;Upload video → Chọn ngôn ngữ → AI tự tách giọng, dịch, clone giọng gốc và lồng tiếng lại. Dùng CPU nên hơi chậm ~5 phút/video 30s.&quot;,
    allow_flagging=&quot;never&quot;
)

if __name__ == &quot;__main__&quot;:
    demo.launch()</code></pre></div></div><!--/$--></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div></div><div class="group/assistant-message-actions mx-auto flex min-h-11 max-w-3xl flex-wrap items-center select-none"><div data-slot="flexbox" class="min-h-0 min-w-0 flex items-center gap-x-1 gap-y-1 [&amp;&gt;*:first-child]:-ms-1"><div class="flex items-center gap-1"><div class="flex" data-state="closed" data-slot="tooltip-trigger"><div class="contents"><button aria-label="Regenerate response" class="enabled:active:scale-98 inline-flex shrink-0 cursor-pointer items-center justify-center rounded-round focus:not-focus-visible:outline-none transition-transform duration-150 ease-in-out disabled:cursor-not-allowed disabled:opacity-50 select-none size-7 hover:enabled:bg-fill-secondary-elevated enabled:active:filter-[brightness(0.965)] dark:enabled:active:filter-[brightness(0.9)] text-text-secondary" data-slot="dropdown-menu-trigger" type="button" id="radix-_R_35c58e6p9iv5soj5ub9cql5db_" aria-haspopup="menu" aria-expanded="false" data-state="closed"><svg viewBox="0 0 32 32" fill="none" width="20" height="20" class="m-0.5"><path d="M15.852 6.96a.876.876 0 0 1 .943-.804 9.84 9.84 0 0 1 6.187 2.861c3.403 3.403 3.802 8.67 1.2 12.512l.965.966a1 1 0 0 1-.444 1.672l-4.008 1.093a1 1 0 0 1-1.228-1.227l1.093-4.009a1 1 0 0 1 1.672-.444l.683.683a8.125 8.125 0 0 0-6.26-12.362.875.875 0 0 1-.803-.942zM6.851 9.503a1 1 0 0 1 .444-1.672l4.008-1.093a1 1 0 0 1 1.228 1.228l-1.093 4.008a1 1 0 0 1-1.672.444l-.683-.683a8.127 8.127 0 0 0 6.265 12.362.875.875 0 0 1-.14 1.745 9.84 9.84 0 0 1-6.19-2.86c-3.404-3.40