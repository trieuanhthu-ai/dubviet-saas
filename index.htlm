    ],
    outputs=gr.Video(label=&quot;Video đã lồng tiếng&quot;),
    title=&quot;AI Dubbing Studio - HeyGen Clone&quot;,
    description=&quot;Upload video → Chọn ngôn ngữ → AI clone giọng lồng tiếng lại. CPU chạy hơi chậm ~5 phút/video 30s.&quot;
)

demo.launch()</code></pre></div></div></div></div><script nonce="OWVhMGQ1ZWUtY2MxMC00ZWZkLTllYjItYTJjZDYzMmZiYTVh">$RC("B:25","S:25")</script><div hidden id="S:26"><div><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Code</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>https://huggingface.co/spaces/hoangnu/heygen-clone
