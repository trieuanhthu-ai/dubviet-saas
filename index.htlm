l.327-.318c3.295-3.216 6.589-6.434 9.883-9.651l-16.558 6.21z" fill="currentColor"></path></svg></button></div><div class="contents"><button aria-label="Menu" class="enabled:active:scale-98 inline-flex shrink-0 cursor-pointer items-center justify-center rounded-round focus:not-focus-visible:outline-none transition-transform disabled:pointer-events-none disabled:opacity-50 select-none size-9 hover:enabled:bg-fill-secondary-elevated enabled:active:filter-[brightness(0.965)] dark:enabled:active:filter-[brightness(0.9)] not-focus-visible:transition-all duration-400 ease-in-out" data-slot="dropdown-menu-trigger" type="button" id="radix-_R_38piv5soj5ub9cql5db_" aria-haspopup="menu" aria-expanded="false" data-state="closed"><svg viewBox="0 0 32 32" fill="none" width="20" height="20" class="m-0.5"><path d="M8 14.125a1.875 1.875 0 1 1 0 3.75 1.875 1.875 0 0 1 0-3.75zm8 0a1.875 1.875 0 1 1 0 3.75 1.875 1.875 0 0 1 0-3.75zm8 0a1.875 1.875 0 1 1 0 3.75 1.875 1.875 0 0 1 0-3.75z" fill="currentColor"></path></svg></button></div></div><script nonce="OWVhMGQ1ZWUtY2MxMC00ZWZkLTllYjItYTJjZDYzMmZiYTVh">$RC("B:12","S:12")</script><div hidden id="S:13"><div><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Bash</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>pip install faster-whisper torch torchaudio TTS ffmpeg-python gradio
pip install transformers sentencepiece
git clone https://github.com/Rudrabha/Wav2Lip.git
cd Wav2Lip &amp;&amp; pip install -r requirements.txt</code></pre></div></div></div></div><script nonce="OWVhMGQ1ZWUtY2MxMC00ZWZkLTllYjItYTJjZDYzMmZiYTVh">$RC("B:13","S:13")</script><div hidden id="S:14"><div><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Python</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>import gradio as gr
import ffmpeg
from faster_whisper import WhisperModel
from TTS.api import TTS
from transformers import pipeline
import subprocess
import os

# 1. Load model 1 lần khi start
whisper = WhisperModel(&quot;medium&quot;, device=&quot;cuda&quot;, compute_type=&quot;float16&quot;) # đổi &quot;small&quot; nếu GPU &lt;6GB
tts = TTS(&quot;tts_models/multilingual/multi-dataset/xtts_v2&quot;).to(&quot;cuda&quot;)
translator = pipeline(&quot;translation&quot;, model=&quot;Helsinki-NLP/opus-mt-en-vi&quot;, device=0) # đổi cặp ngôn ngữ

def process_video(video_path, target_lang):
    output_path = &quot;output_dubbed.mp4&quot;
    audio_path = &quot;temp_audio.wav&quot;

    # B1: Tách audio từ video
    ffmpeg.input(video_path).output(audio_path).run(overwrite_output=True)

    # B2: Whisper tách lời + timestamp
    segments, _ = whisper.transcribe(audio_path, word_timestamps=True)
    full_text = &quot; &quot;.join([seg.text for seg in segments])

    # B3: Dịch văn bản
    if target_lang!= &quot;vi&quot;:
        translated = translator(full_text)[0][&#x27;translation_text&#x27;]
    else:
        translated = full_text # nếu đích là tiếng Việt thì khỏi dịch

    # B4: Clone giọng từ audio gốc + tạo TTS mới
    tts.tts_to_file(text=translated, speaker_wav=audio_path, language=target_lang, file_path=&quot;dub.wav&quot;)

    # B5: Dùng Wav2Lip khớp khẩu hình
    cmd = f&quot;python Wav2Lip/inference.py --checkpoint_path Wav2Lip/checkpoints/wav2lip_gan.pth --face {video_path} --audio dub.wav --outfile {output_path}&quot;
    subprocess.run(cmd, shell=True)

    return output_path, full_text, translated

# Giao diện Gradio
demo = gr.Interface(
    fn=process_video,
    inputs=[gr.Video(label=&quot;Upload Video&quot;), gr.Dropdown([&quot;en&quot;, &quot;vi&quot;, &quot;ja&quot;, &quot;ko&quot;, &quot;zh&quot;], label=&quot;Ngôn ngữ đích&quot;)],
    outputs=[gr.Video(label=&quot;Video đã lồng tiếng&quot;), gr.Textbox(label=&quot;Transcript gốc&quot;), gr.Textbox(label=&quot;Bản dịch&quot;)],
    title=&quot;HeyGen Self-Hosted - 0đ&quot;,
)
demo.launch(share=True)</code></pre></div></div></div></div><script nonce="OWVhMGQ1ZWUtY2MxMC00ZWZkLTllYjItYTJjZDYzMmZiYTVh">$RC("B:14","S:14")</script><div hidden id="S:15"><div><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Code</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>faster-whisper==1.0.3
torch==2.3.1
TTS==0.22.0
transformers==4.44.2
ffmpeg-python==0.2.0
gradio==4.44.0</code></pre></div></div></div></div><script nonce="OWVhMGQ1ZWUtY2MxMC00ZWZkLTllYjItYTJjZDYzMmZiYTVh">$RC("B:15","S:15")</script><div hidden id="S:16"><div><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Code</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>@echo off
