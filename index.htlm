":\"import\"},{\"content\":\" whisper\\n\"},{\"content\":\"import\"},{\"content\":\" torch\\n\"},{\"content\":\"from\"},{\"content\":\" TTS.api \"},{\"content\":\"import\"},{\"content\":\" TTS\\n\"},{\"content\":\"import\"},{\"content\":\" subprocess\\n\"},{\"content\":\"import\"},{\"content\":\" os\\n\"},{\"content\":\"from\"},{\"content\":\" pydub \"},{\"content\":\"import\"},{\"content\":\" AudioSegment\\n\\ndevice = \"},{\"content\":\"\\\"cuda\\\"\"},{\"content\":\" \"},{\"content\":\"if\"},{\"content\":\" torch.cuda.is_available() \"},{\"content\":\"else\"},{\"content\":\" \"},{\"content\":\"\\\"cpu\\\"\"},{\"content\":\"\\nwhisper_model = whisper.load_model(\"},{\"content\":\"\\\"base\\\"\"},{\"content\":\")\\ntts_model = TTS(\"},{\"content\":\"\\\"tts_models/multilingual/multi-dataset/xtts_v2\\\"\"},{\"content\":\").to(device)\\n\\n\"},{\"content\":\"def\"},{\"content\":\" \"},{\"content\":\"dub_video\"},{\"content\":\"(video, target_lang):\\n    \"},{\"content\":\"# 1. Tách audio\"},{\"content\":\"\\n    audio_path = \"},{\"content\":\"\\\"temp_audio.wav\\\"\"},{\"content\":\"\\n    subprocess.run([\"},{\"content\":\"\\\"ffmpeg\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"-i\\\"\"},{\"content\":\", video, \"},{\"content\":\"\\\"-vn\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"-acodec\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"pcm_s16le\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"-ar\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"16000\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"-ac\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"1\\\"\"},{\"content\":\", audio_path])\\n    \\n    \"},{\"content\":\"# 2. Whisper ASR\"},{\"content\":\"\\n    result = whisper_model.transcribe(audio_path, task=\"},{\"content\":\"\\\"translate\\\"\"},{\"content\":\" \"},{\"content\":\"if\"},{\"content\":\" target_lang==\"},{\"content\":\"\\\"en\\\"\"},{\"content\":\" \"},{\"content\":\"else\"},{\"content\":\" \"},{\"content\":\"\\\"transcribe\\\"\"},{\"content\":\")\\n    text = result[\"},{\"content\":\"\\\"text\\\"\"},{\"content\":\"]\\n    \\n    \"},{\"content\":\"# 3. TTS clone giọng\"},{\"content\":\"\\n    tts_model.tts_to_file(text=text, speaker_wav=audio_path, language=target_lang, file_path=\"},{\"content\":\"\\\"output.wav\\\"\"},{\"content\":\")\\n    \\n    \"},{\"content\":\"# 4. Ghép lại video\"},{\"content\":\"\\n    output_video = \"},{\"content\":\"\\\"output.mp4\\\"\"},{\"content\":\"\\n    subprocess.run([\"},{\"content\":\"\\\"ffmpeg\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"-i\\\"\"},{\"content\":\", video, \"},{\"content\":\"\\\"-i\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"output.wav\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"-c:v\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"copy\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"-map\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"0:v:0\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"-map\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"1:a:0\\\"\"},{\"content\":\", output_video])\\n    \"},{\"content\":\"return\"},{\"content\":\" output_video\\n\\ndemo = gr.Interface(\\n    fn=dub_video,\\n    inputs=[gr.Video(label=\"},{\"content\":\"\\\"Upload Video\\\"\"},{\"content\":\"), gr.Dropdown([\"},{\"content\":\"\\\"vi\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"en\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"zh\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"ja\\\"\"},{\"content\":\", \"},{\"content\":\"\\\"ko\\\"\"},{\"content\":\"], label=\"},{\"content\":\"\\\"Ngôn ngữ đích\\\"\"},{\"content\":\")],\\n    outputs=gr.Video(label=\"},{\"content\":\"\\\"Video đã lồng tiếng\\\"\"},{\"content\":\"),\\n    title=\"},{\"content\":\"\\\"AI Dubbing Studio - HeyGen Clone\\\"\"},{\"content\":\",\\n    description=\"},{\"content\":\"\\\"Upload video → Chọn ngôn ngữ → Clone giọng gốc để lồng tiếng\\\"\"},{\"content\":\"\\n)\\n\\ndemo.launch()\"}],\"codeBlockOrdinal\":1,\"html_artifact_sandbox\":null},\"__isGenAIUnifiedResponseSectionViewModel\":\"GenAISin