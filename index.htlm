from gtts import gTTS
import subprocess
import os

# Cài SadTalker lần đầu chạy
if not os.path.exists(&quot;SadTalker&quot;):
    subprocess.run([&quot;git&quot;, &quot;clone&quot;, &quot;https://github.com/OpenTalker/SadTalker.git&quot;])
    subprocess.run([&quot;pip&quot;, &quot;install&quot;, &quot;-r&quot;, &quot;SadTalker/requirements.txt&quot;])

def tao_video_heygen(image, text):
    if image is None or text == &quot;&quot;:
        return None, &quot;Vui lòng up ảnh và nhập chữ&quot;
    
    # 1. Tạo giọng nói từ text
    tts = gTTS(text=text, lang=&#x27;vi&#x27;, slow=False)
    audio_path = &quot;voice.mp3&quot;
    tts.save(audio_path)
    
    # 2. Chạy SadTalker để ghép mặt + giọng
    output_path = &quot;result.mp4&quot;
    cmd = f&quot;cd SadTalker &amp;&amp; python inference.py --driven_audio ../{audio_path} --source_image ../{image} --result_dir ../ --still --preprocess full&quot;
    subprocess.run(cmd, shell=True)
    
    # Tìm file video output
    for file in os.listdir(&quot;.&quot;):
        if file.endswith(&quot;.mp4&quot;) and &quot;full&quot; in file:
            return file, &quot;Tạo video thành công!&quot;
    
    return None, &quot;Lỗi tạo video&quot;

app = gr.Interface(
    fn=tao_video_heygen,
    inputs=[
        gr.Image(type=&quot;filepath&quot;, label=&quot;1. Up ảnh mặt của bạn&quot;),
        gr.Textbox(label=&quot;2. Gõ chữ muốn AI nói&quot;, placeholder=&quot;Xin chào mọi người&quot;)
    ],
    outputs=[
        gr.Video(label=&quot;Video HeyGen của bạn&quot;),
        gr.Textbox(label=&quot;Trạng thái&quot;)
    ],
    title=&quot;HeyGen Clone Full - SadTalker&quot;,
    description=&quot;Up ảnh chân dung + Gõ chữ → AI tạo video nói chuyện&quot;
)

app.launch()</code></pre></div></div></div></div><script nonce="OWVhMGQ1ZWUtY2MxMC00ZWZkLTllYjItYTJjZDYzMmZiYTVh">$RC("B:3c","S:3c")</script><div hidden id="S:3d"><div><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Python</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>import gradio as gr
