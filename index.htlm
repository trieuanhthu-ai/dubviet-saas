from gtts import gTTS
import subprocess
import os

# Cài SadTalker lần đầu chạy
if not os.path.exists(&quot;SadTalker&quot;):
    subprocess.run([&quot;git&quot;, &quot;clone&quot;, &quot;https://github.com/OpenTalker/SadTalker.git&quot;])
    subprocess.run([&quot;pip&quot;, &quot;install&quot;, &quot;-r&quot;, &quot;SadTalker/requirements.txt&quot;])

def tao_video_heygen(image, text):
    if image is None or text == &quot;&quot;:
        return None, &quot;Vui lòng up ảnh và nhập chữ&quot;
    
    # 1. Tạo giọng nói từ text
    tts = gTTS(text=text, lang=&#x27;vi&#x27;, slow=False)
    audio_path = &quot;voice.mp3&quot;
    tts.save(audio_path)
    
    # 2. Chạy SadTalker để ghép mặt + giọng
    output_path = &quot;result.mp4&quot;
    cmd = f&quot;cd SadTalker &amp;&amp; python inference.py --driven_audio ../{audio_path} --source_image ../{image} --result_dir ../ --still --preprocess full&quot;
    subprocess.run(cmd, shell=True)
    
    # Tìm file video output
    for file in os.listdir(&quot;.&quot;):
        if file.endswith(&quot;.mp4&quot;) and &quot;full&quot; in file:
            return file, &quot;Tạo video thành công!&quot;
    
    return None, &quot;Lỗi tạo video&quot;

app = gr.Interface(
    fn=tao_video_heygen,
    inputs=[
        gr.Image(type=&quot;filepath&quot;, label=&quot;1. Up ảnh mặt của bạn&quot;),
        gr.Textbox(label=&quot;2. Gõ chữ muốn AI nói&quot;, placeholder=&quot;Xin chào mọi người&quot;)
    ],
    outputs=[
        gr.Video(label=&quot;Video HeyGen của bạn&quot;),
        gr.Textbox(label=&quot;Trạng thái&quot;)
    ],
    title=&quot;HeyGen Clone Full - SadTalker&quot;,
    description=&quot;Up ảnh chân dung + Gõ chữ → AI tạo video nói chuyện&quot;
)

app.launch()</code></pre></div></div><!--/$--></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div></div><div class="group/assistant-message-actions mx-auto flex min-h-11 max-w-3xl flex-wrap items-center select-none"><div data-slot="flexbox" class="min-h-0 min-w-0 flex items-center gap-x-1 gap-y-1 [&amp;&gt;*:first-child]:-ms-1"><div class="flex items-center gap-1"><div class="flex" data-state="closed" data-slot="tooltip-trigger"><div class="contents"><button aria-label="Regenerate response" class="enabled:active:scale-98 inline-flex shrink-0 cursor-pointer items-center justify-center rounded-round focus:not-focus-visible:outline-none transition-transform duration-150 ease-in-out disabled:cursor-not-allowed disabled:opacity-50 select-none size-7 hover:enabled:bg-fill-secondary-elevated enabled:active:filter-[brightness(0.965)] dark:enabled:active:filter-[brightness(0.9)] text-text-secondary" data-slot="dropdown-menu-trigger" type="button" id="radix-_R_35c58smp9iv5soj5ub9cql5db_" aria-haspopup="menu" aria-expanded="false" data-state="closed"><svg viewBox="0 0 32 32" fill="none" width="20" height="20" class="m-0.5"><path d="M15.852 6.96a.876.876 0 0 1 .943-.804 9.84 9.84 0 0 1 6.187 2.861c3.403 3.403 3.802 8.67 1.2 12.512l.965.966a1 1 0 0 1-.444 1.672l-4.008 1.093a1 1 0 0 1-1.228-1.227l1.093-4.009a1 1 0 0 1 1.672-.444l.683.683a8.125 8.125 0 0 0-6.26-12.362.875.875 0 0 1-.803-.942zM6.851 9.503a1 1 0 0 1 .444-1.672l4.008-1.093a1 1 0 0 1 1.228 1.228l-1.093 4.008a1 1 0 0 1-1.672.444l-.683-.683a8.127 8.127 0 0 0 6.265 12.362.875.875 0 0 1-.14 1.745 9.84 9.84 0 0 1-6.19-2.86c-3.404-3.403-3.8