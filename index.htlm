content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><!--$?--><template id="B:4d"></template><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">JavaScript</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>startBtn.addEventListener(&#x27;click&#x27;, async () =&gt; {
  const API_KEY = &#x27;DÁN_KEY_ELEVENLABS_CỦA_BẠN_VÀO_ĐÂY&#x27;;
  readyState.classList.add(&#x27;hidden&#x27;);
  processContainer.classList.remove(&#x27;hidden&#x27;);
  progressText.textContent = &#x27;Đang gửi video lên AI...&#x27;;
  
  // Gửi video lên ElevenLabs Dubbing
  const form = new FormData();
  form.append(&#x27;file&#x27;, selectedFile);
  form.append(&#x27;target_lang&#x27;, document.getElementById(&#x27;targetLang&#x27;).value);
  
  const res = await fetch(&#x27;https://api.elevenlabs.io/v1/dubbing&#x27;, {
    method: &#x27;POST&#x27;,
    headers: { &#x27;xi-api-key&#x27;: API_KEY },
    body: form
  });
  const data = await res.json();
  // ...AI xử lý 60s...
  progressBar.style.width = &#x27;100%&#x27;;
  resultVideo.src = data.video_url; // video đã lồng tiếng
  processContainer.classList.add(&#x27;hidden&#x27;);
  resultContainer.classList.remove(&#x27;hidden&#x27;);
