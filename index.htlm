export default function Upload() {
  return (
    &lt;div style={{maxWidth:500,margin:&#x27;40px auto&#x27;,fontFamily:&#x27;system-ui&#x27;,padding:20}}&gt;
      &lt;h1 style={{textAlign:&#x27;center&#x27;}}&gt;Dịch Video Sang Tiếng Việt&lt;/h1&gt;
      
      {/* BƯỚC 1 */}
      &lt;div style={{background:&#x27;#f9fafb&#x27;,padding:20,borderRadius:12,marginBottom:20}}&gt;
        &lt;h3&gt;Bước 1: Chọn video&lt;/h3&gt;
        &lt;input type=&quot;file&quot; accept=&quot;video/*&quot; style={{width:&#x27;100%&#x27;,padding:10}}/&gt;
      &lt;/div&gt;

      {/* BƯỚC 2 */}
      &lt;div style={{background:&#x27;#f9fafb&#x27;,padding:20,borderRadius:12,marginBottom:20}}&gt;
        &lt;h3&gt;Bước 2: Chọn tiếng Việt&lt;/h3&gt;
        &lt;p&gt;Ngôn ngữ đích:&lt;/p&gt;
        &lt;select style={{width:&#x27;100%&#x27;,padding:12,fontSize:16}}&gt;
          &lt;option selected&gt;🇻🇳 Tiếng Việt&lt;/option&gt;
          &lt;option&gt;🇺🇸 Tiếng Anh&lt;/option&gt;
          &lt;option&gt;🇨🇳 Tiếng Trung&lt;/option&gt;
          &lt;option&gt;🇰🇷 Tiếng Hàn&lt;/option&gt;
        &lt;/select&gt;
        &lt;p style={{marginTop:10}}&gt;Giọng đọc:&lt;/p&gt;
        &lt;select style={{width:&#x27;100%&#x27;,padding:12}}&gt;
          &lt;option&gt;Nam miền Bắc&lt;/option&gt;
          &lt;option&gt;Nữ miền Bắc&lt;/option&gt;
          &lt;option&gt;Nam miền Nam&lt;/option&gt;
          &lt;option&gt;Nữ miền Nam&lt;/option&gt;
        &lt;/select&gt;
      &lt;/div&gt;

      {/* BƯỚC 3 */}
      &lt;div style={{background:&#x27;#f9fafb&#x27;,padding:20,borderRadius:12}}&gt;
        &lt;h3&gt;Bước 3: Bấm dịch&lt;/h3&gt;
        &lt;button style={{width:&#x27;100%&#x27;,padding:16,background:&#x27;#7c3aed&#x27;,color:&#x27;white&#x27;,border:0,borderRadius:8,fontSize:18,fontWeight:&#x27;bold&#x27;}}&gt;
          BẮT ĐẦU DỊCH NGAY
        &lt;/button&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  )
}</code></pre></div></div></div></div><script nonce="OWVhMGQ1ZWUtY2MxMC00ZWZkLTllYjItYTJjZDYzMmZiYTVh">$RC("B:4c","S:4c")</script><div hidden id="S:4d"><div><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">JavaScript</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>startBtn.addEventListener(&#x27;click&#x27;, async () =&gt; {
  const API_KEY = &#x27;DÁN_KEY_ELEVENLABS_CỦA_BẠN_VÀO_ĐÂY&#x27;;
  readyState.classList.add(&#x27;hidden&#x27;);
  processContainer.classList.remove(&#x27;hidden&#x27;);
  progressText.textContent = &#x27;Đang gửi video lên AI...&#x27;;
  
  // Gửi video lên ElevenLabs Dubbing
  const form = new FormData();
  form.append(&#x27;file&#x27;, selectedFile);
  form.append(&#x27;target_lang&#x27;, document.getElementById(&#x27;targetLang&#x27;).value);
  
  const res = await fetch(&#x27;https://api.elevenlabs.io/v1/dubbing&#x27;, {
    method: &#x27;POST&#x27;,
    headers: { &#x27;xi-api-key&#x27;: API_KEY },
    body: form
  });
  const data = await res.json();
  // ...AI xử lý 60s...
  progressBar.style.width = &#x27;100%&#x27;;
  resultVideo.src = data.video_url; // video đã lồng tiếng
  processContainer.classList.add(&#x27;hidden&#x27;);
  resultContainer.classList.remove(&#x27;hidden&#x27;);
});</code></pre></div></div></div></div><script nonce="OWVhMGQ1ZWUtY2MxMC00ZWZkLTllYjItYTJjZDYzMmZiYTVh">$RC("B:4d","S:4d")</script><div hidden id="S:4e"><div><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Code</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>[ chính ▼ ] [ 1 Chi nhánh ] [ 0 thẻ ]          [ Chuyển đến tệp ]   [ Thêm tệp ▼ ] ← BẤM VÀO ĐÂY
