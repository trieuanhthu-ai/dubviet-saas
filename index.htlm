 này\",\"197wca\":\"Có thể liên kết bị hỏng, trang bị gỡ hoặc cài đặt quyền riêng tư đã thay đổi. Hãy kiểm tra xem liên kết mà bạn đang cố mở đã chính xác chưa.\",\"4piWhW\":\"Đến Trang chủ\",\"1vWdyn\":\"Đang tạo cuộc trò chuyện chung...\",\"4bzLr6\":\"Giả liệu được chia sẻ\",\"2JsPvk\":\"Đã sao chép liên kết vào bộ nhớ tạm\",\"2OSvZe\":\"Không sao chép được liên kết\",\"45m1YR\":\"Meta AI\",\"1PmOgw\":\"Nội dung là do người dùng tạo và chưa được xác minh.\",\"3TXhg\":\"Chia sẻ\",\"15PKCz\":\"Tạo liên kết\",\"4oIL4n\":\"Đóng\",\"2pnObP\":\"Thiếu ID báo cáo\",\"3tyoRG\":\"Cần có ID báo cáo để xem trạng thái báo cáo. Vui lòng kiểm tra liên kết rồi thử lại.\",\"1H6aWS\":\"Đã xảy ra lỗi\",\"29TPLy\":\"Đã xảy ra lỗi khi tải trang này. Vui lòng thử lại.\",\"3KCvfZ\":\"Đến Trang chủ\",\"F7yoO\":\"Làm mới\",\"CH6uq\":\"Không tải được\",\"5U7jn\":\"Chúng tôi không thể tải trạng thái báo cáo. Vui lòng thử lại sau.\",\"18kEAD\":\"Thông báo\",\"17Si2Y\":\"Mới\",\"3gw1kk\":\"Trước đó\",\"3cH8vu\":\"Điểm truy cập không hợp lệ\",\"3mEBrb\":\"Điểm truy cập phải là \\\"chi tiết\\\" hoặc \\\"kháng nghị\\\". Vui lòng kiểm tra liên kết rồi thử lại.\",\"171Q8f\":\"Thiếu ID quá trình thực thi\",\"1gEHDD\":\"Cần có ít nhất 1 ID thực thi để xem trạng thái tài khoản. Vui lòng kiểm tra liên kết rồi thử lại.\",\"3DtgId\":\"Chưa tải được trạng thái tài khoản. Vui lòng thử lại sau.\",\"FA65r\":\"Mô tả một hình ảnh hoặc video...\",\"3ufBwf\":\"Quay lại quy trình tự động hóa\",\"GXswW\":\"Lịch sử thực hiện\",\"h3HUK\":\"Dòng thời gian\",\"4C1Q59\":\"@{username}\",\"2urcSN\":\"{totalCount} bản sửa đổi dựa trên cảm hứng, {publicCount} bản sửa đổi công khai\",\"MHyHH\":\"File phương tiện\",\"1FuFOj\":\"Giả liệu\",\"2hHUkc\":\"Yêu thích\",\"lzjjE\":\"Đã chia sẻ\",\"eV1Zw\":\"Tất cả\",\"FVAJB\":\"Trang chiếu\",\"3gLX5X\":\"Trang web\",\"vE88c\":\"Tài liệu\",\"4uFjTz\":\"Âm thanh\",\"kvJFn\":\"Bảng tính\",\"409KXj\":\"Lọc\",\"1Xs4lq\":\"Xem\",\"3res2N\":\"Tạo bất cứ thứ gì...\",\"2Fvoe3\":\"Tải file lên\",\"3z6KQF\":\"Công cụ tạo tập trung\",\"19ltgc\":\"Tin nhắn trước\",\"3UgcV9\":\"Tin nhắn tiếp theo\",\"2A3cmD\":\"Dừng tạo\",\"3nVOeS\":\"Đặt thêm câu hỏi...\",\"3zGHt8\":\"Trình duyệt web Manus\",\"2QPTUW\":\"Không tìm thấy file phương tiện nào\",\"4uiHzi\":\"Đóng\",\"1YXLFy\":\"Tạo, sửa đổi và chia sẻ video AI\",\"4tWcui\":\"Mô tả hoạt ảnh của bạn...\",\"4hJlxC\":\"Tạo hoạt ảnh cho ảnh của tôi\",\"1xg8bF\":\"Tạo hình ảnh robot của thập niên 90\",\"3puy9D\":\"Đổi phong cách ảnh của tôi thành 3D\",\"XNu2o\":\"Tạo và chỉnh sửa hình ảnh chỉ sau vài giây\",\"1yOD1b\":\"Tạo ngay hình ảnh chất lượng cao với câu lệnh văn bản đơn giản. Ngoài ra, bạn có thể tải hình ảnh của mình lên để biến đổi thành nội dung hoàn toàn mới. Thay đổi hoặc gỡ phông nền, đổi trang phục và làm nhiều việc khác nhằm tạo ảnh chế vui nhộn để chia sẻ với bạn bè, kể những câu chuyện mới hoặc thể hiện cá tính riêng qua các tác phẩm nghệ thuật ấn tượng.\",\"2iGSWH\":\"Tạo hình ảnh AI\",\"mwmeE\":\"Ví dụ về việc tạo video AI\",\"JhtHf\":\"Thổi hồn vào tác phẩm của bạn\",\"1eMkGC\":\"Tạo vibe (các video giàu sức biểu đạt do AI tạo) bằng cách tạo hoạt ảnh cho hình ảnh với một lần nhấp vào nút hoặc bằng cách mô tả đúng những gì bạn muốn tạo với câu lệnh tạo hoạt ảnh tùy chỉnh. Ngoài ra, bạn có thể kéo dài thời lượng video, đổi phong cách cho video và thêm nhạc.\",\"FHZv1\":\"Tạo video AI\",\"1aXPMi\":\"Ví dụ về hoạt ảnh video AI\",\"2mUnoG\":\"Tìm cảm hứng và thử áp dụng ý tưởng mới\",\"GDMjC\":\"Khám phá bảng feed sống động gồm các video do AI tạo giàu sức biểu đạt và sáng tạo từ cộng đồng. Sửa đổi vibe bạn yêu thích để thử ngay ý tưởng mới và thể hiện theo phong cách độc đáo của bạn.\",\"4iSjSr\":\"Bắt đầu\",\"2VDjhP\":\"Ví dụ về video AI của cộng đồng\",\"1V5OAw\":\"Chia sẻ và kết nối theo những cách mới\",\"4hxhZq\":\"Chia sẻ vibe của bạn với bạn bè và khơi mào cuộc trò chuyện mới hoặc đăng các vibe đó lên bảng feed Meta AI để truyền cảm hứng cho cộng đồng người sáng tạo nội dung AI.\",\"18sHic\":\"Chia sẻ tác phẩm\",\"4dzWGF\":\"Ví dụ về việc chia sẻ video AI\",\"2H1Ir3\":\"Khám phá các tính năng tạo và chỉnh sửa hình ảnh, video của Meta AI\",\"3k5oFp\":\"Biểu tượng của tính năng hoạt ảnh tùy chỉnh\",\"2aSDkL\":\"Tạo hoạt ảnh tùy chỉnh\",\"Mp6Ny\":\"Biến đúng những gì bạn hình dung thành hiện thực nhờ câu lệnh bằng văn bản dành cho hoạt ảnh tùy chỉnh.\",\"2jjJDC\":\"Biểu tượng của tính năng chỉnh sửa hình ảnh\",\"2DUyob\":\"Chỉnh sửa hình ảnh\",\"3kJ8Uj\":\"Tải hình ảnh lên và biến đổi đối tượng, phông nền, v.v.\",\"4omYfj\":\"Biểu tượng kéo dài thời lượng video\",\"G47h9\":\"Tăng thời lượng video\",\"2PLr43\":\"Kéo dài thời lượng video chỉ bằng một lần nhấp.\",\"4xqbOe\":\"Biểu tượng của tính năng làm được nhiều việc hơn\",\"4y3CkV\":\"Làm được nhiều việc hơn\",\"3EDC6W\":\"Khai thác các công cụ nâng cao để điều chỉnh mức độ đa dạng, tính độc đáo và nhiều yếu tố khác.\",\"20TjjF\":\"Biểu tượng của tính năng xem tác phẩm\",\"2UbNW7\":\"Xem tác phẩm của bạn\",\"461omF\":\"Xem mọi file phương tiện ở một nơi và trong thư viện sáng tạo.\",\"uj0jn\":\"Biểu tượng của tính năng đổi phong cách và chỉnh sửa\",\"2GCgGB\":\"Đổi phong cách và chỉnh sửa\",\"3WA1rk\":\"Đổi phong cách ngay cho video bằng chế độ đặt sẵn hoặc chỉnh sửa chính xác.\",\"yYZxj\":\"Meta AI\",\"3tStIE\":\"Công cụ tạo hình ảnh AI\",\"2o0aIP\":\"Công cụ tạo hình ảnh và video AI\",\"3ERRUu\":\"Tạo hình ảnh và video AI\",\"4e5LiV\":\"Tạo hình ảnh...\",\"3kZe6K\":\"Tạo hoạt ảnh cho ảnh của tôi\",\"3vSg5S\":\"Tạo hình ảnh robot của thập niên 90\",\"qx4m2\":\"Đổi phong cách ảnh của tôi thành 3D\",\"3YZIRC\":\"Tạo hình ảnh chú chó trong vai vị vua\",\"saAux\":\"Tạo hình ảnh AI chỉ sau vài giây\",\"unKxM\":\"Thổi hồn cho ý tưởng bằng cách dùng Meta AI để tạo những hình ảnh AI ấn tượng. Bắt đầu bằng một câu lệnh văn bản đơn giản để tạo bất kỳ hình ảnh AI nào. Thỏa sức tưởng tượng bằng cách dùng công cụ tạo hình ảnh của Meta AI và bắt đầu tạo hình ảnh AI, bất kể là ảnh chế cho vui, đồ họa thông tin cho dự án ở trường hay hình ảnh AI về chính bạn.\",\"BOSNL\":\"Tạo hình ảnh AI\",\"1sOwmi\":\"Ví dụ về hình ảnh do AI tạo\",\"X4Cf\":\"Tạo hoạt ảnh cho hình ảnh bất kỳ bằng AI\",\"3qDhFh\":\"Trổ tài sáng tạo với các tính năng tạo hoạt ảnh của Meta AI. Tạo hình ảnh AI bất kỳ rồi yêu cầu Meta AI tạo hoạt ảnh cho hình ảnh đó. Bạn cũng có thể tải lên hình ảnh của chính mình và tạo hoạt ảnh cho hình ảnh đó. Chia sẻ hoạt ảnh AI với cộng đồng và tìm cảm hứng từ những ý tưởng mới. Với Meta AI, nghệ thuật tạo hoạt ảnh có tiềm năng vô hạn.\",\"zFDlz\":\"Tạo hoạt ảnh bằng AI\",\"43Oplb\":\"Ví dụ về hoạt ảnh AI\",\"3yOzHR\":\"Chỉnh sửa hình ảnh của riêng bạn bằng AI\",\"2Pd1gE\":\"Thiết kế \\\"xịn\\\" như chuyên gia bằng các tính năng chỉnh sửa hình ảnh của Meta AI. Tải hình ảnh bất kỳ lên rồi yêu cầu Meta AI thêm hoặc thay đổi các phần trong hình ảnh. Bạn cũng có thể dùng Meta AI làm công cụ xóa phông nền hoặc đổi phong cách cho hình ảnh bằng rất nhiều phong cách, màu sắc và lựa chọn ánh sáng AI – từ anime và tranh vẽ cho đến ánh sáng trầm buồn và hoàng hôn.\",\"3BPE26\":\"Chỉnh sửa hình ảnh bằng AI\",\"r3RYI\":\"Ví dụ về việc chỉnh sửa hình ảnh AI\",\"1aRwJP\":\"Khám phá các tính năng tạo và chỉnh sửa hình ảnh, video của Meta AI\",\"1jorZh\":\"Biểu tượng của tính năng tạo hình ảnh\",\"4avj1s\":\"Tạo hình ảnh\",\"39fujj\":\"Biến bất kỳ ý tưởng nào thành hiện thực nhờ một câu lệnh đơn giản bằng văn bản.\",\"3xYrlx\":\"Biểu tượng của tính năng tạo hình ảnh về chính bạn\",\"3khKEB\":\"Tạo hình ảnh về chính bạn\",\"2xiiM3\":\"Tưởng tượng bạn đang ở trên mặt trăng, thử kiểu tóc mới và hơn thế nữa.\",\"3Csrag\":\"Biểu tượng của tính năng chỉnh sửa hình ảnh\",\"ZC6nL\":\"Chỉnh sửa hình ảnh\",\"2joW4q\":\"Thêm, xóa hoặc thay đổi các phần trong hình ảnh.\",\"25qEXy\":\"Biểu tượng của tính năng đổi phong cách cho hình ảnh\",\"2fR5rp\":\"Đổi phong cách cho hình ảnh\",\"4kXlLy\":\"Khám phá thư viện phong cách của chúng tôi để đổi phong cách cho hình ảnh chỉ bằng một lần nhấp.\",\"2wTBZs\":\"Biểu tượng của tính năng tạo hoạt ảnh cho hình ảnh\",\"3sWKip\":\"Tạo hoạt ảnh cho hình ảnh\",\"fm0h3\":\"Biến hình ảnh bạn tạo hoặc tải lên thành hoạt ảnh.\",\"2bn6Iz\":\"Biểu tượng của tính năng phân tích hình ảnh\",\"21sgXl\":\"Phân tích hình ảnh\",\"2397NU\":\"Đặt bất kỳ câu hỏi nào về hình ảnh.\",\"19QHem\":\"Bỏ qua\",\"BRfT3\":\"Ngưng tải lên\",\"oXXAw\":\"Đang tải file lên...\",\"1QVq4D\":\"Bạn chờ chút nhé\",\"20tydv\":\"Tải file lên\",\"3fMQ6J\":\"Tải file lên hoặc dán URL\",\"3AtRNT\":\"Gửi URL\",\"CIBXS\":\"Hỗ trợ file JPEG, PNG, WEBP, GIF, MP4 và MOV. Liên kết trực tiếp phải truy cập được công khai.\",\"389u3l\":\"Meta\",\"29l18a\":\"Meta AI\",\"1DAyxT\":\"Thông tin về dữ liệu xác thực nội dung và cách chúng tôi biết được thông tin này. {=m2}\",\"4qPdv9\":\"Tìm hiểu thêm\",\"3KShzb\":\"Bỏ qua kết quả\",\"39GPQn\":\"Không tìm thấy chữ ký Meta AI nào\",\"3LCtfr\":\"Chúng tôi không tìm thấy thông tin về việc sử dụng AI tạo sinh của Meta AI trong file này.\",\"4yMvk3\":\"Xác định file được tạo hoặc chỉnh sửa bằng AI\",\"n4Hrd\":\"Tải file lên để tìm hiểu thêm xem file có được tạo hoặc chỉnh sửa bằng công cụ AI không\",\"42fJbs\":\"Tải file khác lên\",\"1cSFtK\":\"Tải file khác lên\",\"43gUzF\":\"ID: {instanceId}\",\"2ZYyw2\":\"Bỏ qua kết quả\",\"38tQPA\":\"Đã tìm thấy chữ ký Meta AI\",\"3I65EW\":\"Dưới đây là những gì chúng tôi tìm thấy về file này:\",\"1xfw1g\":\"Theo thông tin bạn cung cấp, bạn chưa thể sử dụng Meta AI\",\"tnXVX\":\"Tìm hiểu thêm về {=m2} và {=m6} của Meta.\",\"44VrZB\":\"Điều khoản\",\"3tVqQt\":\"Điều khoản về AI\",\"4akhn7\":\"Loại file không được hỗ trợ. Vui lòng tải lên video ở định dạng MP4 hoặc MOV.\",\"1rmi2X\":\"Không thể đọc file video. Vui lòng thử dùng file khác.\",\"30rfCv\":\"H: {high}° L: {low}°\",\"8vbUf\":\"Đang tạo file PDF…\",\"28c1cV\":\"Không tạo được file PDF. Hãy thử lại.\",\"1lFNhC\":\"Đang tạo file PowerPoint…\",\"25jZTe\":\"Không xuất được trang chiếu sang PowerPoint. Hãy thử lại.\",\"4yTp6k\":\"Không tải xuống được. Vu