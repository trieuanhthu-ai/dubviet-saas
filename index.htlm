from faster_whisper import WhisperModel
from TTS.api import TTS
from transformers import pipeline

whisper = WhisperModel(&quot;small&quot;, device=&quot;cuda&quot;)
tts = TTS(&quot;tts_models/multilingual/multi-dataset/xtts_v2&quot;).to(&quot;cuda&quot;)
translator = pipeline(&quot;translation&quot;, model=&quot;Helsinki-NLP/opus-mt-en-vi&quot;, device=0)

def dub_video(video, lang):
    audio = &quot;temp.wav&quot;
    # Rút gọn: code đầy đủ mình để ở link dưới
    return video # Tạm thời, bạn lấy full code ở link

demo = gr.Interface(dub_video, [gr.Video(), gr.Dropdown([&quot;en&quot;,&quot;vi&quot;,&quot;ja&quot;])], gr.Video())
demo.launch()</code></pre></div></div><!--/$--></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><!--$?--><template id="B:19"></template><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Code</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>faster-whisper
