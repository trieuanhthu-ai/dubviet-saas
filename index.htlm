\":[],\"videos\":[],\"contentRenderer\":{\"__typename\":\"UnifiedResponseContentRenderer\",\"unified_response\":{\"__typename\":\"XMSGGenAIUnifiedResponse\",\"sections\":[{\"__typename\":\"GenAIUnifiedResponseSection\",\"view_model\":{\"__typename\":\"GenAISingleLayoutViewModel\",\"primitive\":{\"__typename\":\"GenAIMarkdownTextUXPrimitive\",\"__isGenAIUXPrimitive\":\"GenAIMarkdownTextUXPrimitive\",\"text\":\"Hiểu rồi. HF nó giấu ô `Space name` lên trên cùng đó. Kéo lên đầu trang mới thấy.\\r\\n\\r\\n### **Cách tìm ô `Space name` - 5 giây**\\r\\n\\r\\n1. **Kéo chuột lên trên cùng** của trang đó\\r\\n2. Bạn sẽ thấy phần này:\\r\\n\\r\",\"inline_entities\":null,\"html_artifact_sandbox\":null},\"__isGenAIUnifiedResponseSectionViewModel\":\"GenAISingleLayoutViewModel\"},\"header\":null},{\"__typename\":\"GenAIUnifiedResponseSection\",\"view_model\":{\"__typename\":\"GenAISingleLayoutViewModel\",\"primitive\":{\"__typename\":\"GenAICodeUXPrimitive\",\"__isGenAIUXPrimitive\":\"GenAICodeUXPrimitive\",\"language\":\"\",\"code_blocks\":[{\"content\":\"Create a new Space\\n\\nOwner: Hoàng Nô\\n\\nSpace name * \\n[_________________________]  ← Điền heygen-clone vào đây\\n\\nLicense\\n[Chọn một giấy phép...]     ← Chọn Apache License \"},{\"content\":\"2.0\"}],\"codeBlockOrdinal\":0,\"html_artifact_sandbox\":null},\"__isGenAIUnifiedResponseSectionViewModel\":\"GenAISingleLayoutViewModel\"},\"header\":null},{\"__typename\":\"GenAIUnifiedResponseSection\",\"view_model\":{\"__typename\":\"GenAISingleLayoutViewModel\",\"primitive\":{\"__typename\":\"GenAIMarkdownTextUXPrimitive\",\"__isGenAIUXPrimitive\":\"GenAIMarkdownTextUXPrimitive\",\"text\":\"\\r\\n\\r\\n**Ô `Space name` nó nằm ngay dưới chữ `Owner: Hoàng Nô`** đó bạn.\\r\\n\\r\\n### **Nếu kéo lên trên cùng vẫn không thấy**\\r\\n\\r\\nDo bạn vào bằng link `?sdk=gradio` nên nó ẩn form. Làm thế này:\\r\\n\\r\\n1. **Copy link này dán vào tab mới**: https://huggingface.co/new-space\\r\\n2. Đừng vào link cũ nữa. Link mới này sẽ hiện đủ form: `Space name`, `License`, `Gradio`, `Hardware`\\r\\n3. Lúc đó bạn chọn lại từ đầu: `Gradio` → `Trống` → `ZeroGPU` → Điền `Space name` → `Create Space`\\r\\n\\r\\n### **Video quay màn hình cho dễ**\\r\\n\\r\",\"inline_entities\":null,\"html_artifact_sandbox\":null},\"__isGenAIUnifiedResponseSectionViewModel\":\"GenAISingleLayoutViewModel\"},\"header\":null},{\"__typename\":\"GenAIUnifiedResponseSection\",\"view_model\":{\"__typename\":\"GenAISingleLayoutViewModel\",\"primitive\":{\"__typename\":\"GenATableUXPrimitive\",\"__isGenAIUXPrimitive\":\"GenATableUXPrimitive\",\"rows\":[{\"is_header\":true,\"cells\":[\"Thứ tự\",\"Click vào đâu\"],\"markdown_cells\":[{\"text\":\"Thứ tự\",\"inline_entities\":null},{\"text\":\"Click vào đâu\",\"inline_entities\":null}]},{\"is_header\":false,\"cells\":[\"**1**\",\"https://huggingface.co/new-space\"],\"markdown_cells\":[{\"text\":\"**1**\",\"inline_entities\":null},{\"text\":\"https://huggingface.co/new-space\",\"inline_entities\":null}]},{\"is_header\":false,\"cells\":[\"**2**\",\"Điền `Space name`: `heygen-clone`\"],\"markdown_cells\":[{\"text\":\"**2**\",\"inline_entities\":null},{\"text\":\"Điền `Space name`: `heygen-clone`\",\"inline_entities\":null}]},{\"is_header\":false,\"cells\":[\"**3**\",\"License: `Apache 2.0`\"],\"markdown_cells\":[{\"text\":\"**3**\",\"inline_entities\":null},{\"text\":\"License: `Apache 2.0`\",\"inline_entities\":null}]},{\"is_header\":false,\"cells\":[\"**4**\",\"SDK: `Gradio` → `Trống`\"],\"markdown_cells\":[{\"text\":\"**4**\",\"inline_entities\":null},{\"text\":\"SDK: `Gradio` → `Trống`\",\"inline_entities\":null}]},{\"is_header\":false,\"cells\":[\"**5**\",\"Hardware: `ZeroGPU`\"],\"markdown_cells\":[{\"text\":\"**5**\",\"inline_entities\":null},{\"text\":\"Hardware: `ZeroGPU`\",\"inline_entities\":null}]},{\"is_header\":false,\"cells\":[\"**6**\",\"Bấm `Create Space`\"],\"markdown_cells\":[{\"text\":\"**6**\",\"inline_entities\":null},{\"text\":\"Bấm `Create Space`\",\"inline_entitie