class="mt-4 "><div data-slot="flexbox" class="min-h-0 min-w-0 flex flex-col gap-x-0 gap-y-0 shrink-0"><div class="w-full min-w-0"><div class="group/assistant-message relative min-w-0" data-testid="assistant-message" data-streaming-state="DONE" data-streaming-complete="true"><div class="mx-auto flex w-full max-w-3xl items-start gap-3 min-h-[26px]"><div class="-ms-1 flex shrink-0 items-center"><div class="" style="width:24px;height:24px" aria-hidden="true"></div></div><div class="min-w-0 flex-1"><div class="w-full min-w-0"></div></div></div><div class="mt-4"><div class="w-full min-w-0"><div class="min-w-0 space-y-6"><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><!--$?--><template id="B:29"></template><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Python</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>import gradio as gr
import whisper
import torch
from TTS.api import TTS
import subprocess
import os
import tempfile

device = &quot;cpu&quot;
whisper_model = whisper.load_model(&quot;base&quot;)
tts = TTS(&quot;tts_models/multilingual/multi-dataset/xtts_v2&quot;).to(device)

def dub_video(video_path, target_language):
    if video_path is None: return None
    with tempfile.TemporaryDirectory() as tmpdir:
        audio_path = os.path.join(tmpdir, &quot;audio.wav&quot;)
        subprocess.run([&quot;ffmpeg&quot;, &quot;-i&quot;, video_path, &quot;-vn&quot;, &quot;-acodec&quot;, &quot;pcm_s16le&quot;, &quot;-ar&quot;, &quot;16000&quot;, &quot;-ac&quot;, &quot;1&quot;, audio_path, &quot;-y&quot;])
        result = whisper_model.transcribe(audio_path, task=&quot;translate&quot; if target_language==&quot;en&quot; else &quot;transcribe&quot;)
        text = result[&quot;text&quot;]
        output_audio = os.path.join(tmpdir, &quot;output.wav&quot;)
        tts.tts_to_file(text=text, speaker_wav=audio_path, language=target_language, file_path=output_audio)
        output_video = os.path.join(tmpdir, &quot;output.mp4&quot;)
        subprocess.run([&quot;ffmpeg&quot;, &quot;-i&quot;, video_path, &quot;-i&quot;, output_audio, &quot;-c:v&quot;, &quot;copy&quot;, &quot;-map&quot;, &quot;0:v:0&quot;, &quot;-map&quot;, &quot;1:a:0&quot;, &quot;-shortest&quot;, output_video, &quot;-y&quot;])
        return output_video

demo = gr.Interface(
    fn=dub_video,
    inputs=[gr.Video(label=&quot;Upload Video&quot;), gr.Dropdown([&quot;vi&quot;, &quot;en&quot;, &quot;zh&quot;, &quot;ja&quot;, &quot;ko&quot;], value=&quot;vi&quot;, label=&quot;Ngôn ngữ&quot;)],
    outputs=gr.Video(label=&quot;Kết quả&quot;),
    title=&quot;AI Dubbing Studio&quot;
)
demo.launch()</code></pre></div></div><!--/$--></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div></div><div class="group/assistant-message-actions mx-auto flex min-h-11 max-w-3xl flex-wrap items-center select-none"><div data-slot="flexbox" class="min-h-0 min-w-0 flex items-center gap-x-1 gap-y-1 [&amp;&gt;*:first-child]:-ms-1"><div class="flex items-center gap-1"><div class="flex" data-state="closed" data-slot="tooltip-trigger"><div class="contents"><button aria-label="Regenerate response" class="enabled:active:scale-98 inline-flex shrink-0 cursor-pointer items-center justify-center rounded-round focus:not-focus-visible:outline-none transition-transform duration-150 ease-in-out disabled:cursor-not-allowed disabled:opacity-50 select-none size-7 hover:enabled:bg-fill-secondary-elevated enabled:active:filter-[brightness(0.965)] dark:enabled:active:filter-[brightness(0.9)] text-text-secondary" data-slot="dropdown-menu-trigger" type="button" id="radix-_R_35c58i6p9iv5soj5ub9cql5db_" aria-haspopup="menu" aria-expanded="false" data-state="closed"><svg viewBox="0 0 32 32" fill="none" width="20" height="20" class="m-0.5"><path d="M15.852 6.96a.876.876 0 0 1 .943-.804 9.84 9.84 0 0 1 6.187 2.861c3.403 3.403 3.802 8.67 1.2 12.512l.965.966a1 1 0 0 1-.444 1.672l-4.008 1.093a1 1 0 0 1-1.228-1.227l1.093-4.009a1 1 0 0 1 1.672-.444l.683.683a8.125 8.125 0 0 0-6.26-12.362.875.875 0 0 1-.803-.942zM6.851 9.503a1 1 0 0 1 .444-1.672l4.008-1.093a1 1 0 0 1 1.228 1.228l-1.093 4.008a1 1 0 0 1-1.672.444l-.683-.683a8.127 8.127 0 0 0 6.265 12.362.875.875 0 0 1-.14 1.745 9.84 9.84 0 0 1-6.19-2.86c-3.404-3.403-3.