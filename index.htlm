3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><!--$?--><template id="B:13"></template><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Bash</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>pip install faster-whisper torch torchaudio TTS ffmpeg-python gradio
pip install transformers sentencepiece
git clone https://github.com/Rudrabha/Wav2Lip.git
cd Wav2Lip &amp;&amp; pip install -r requirements.txt</code></pre></div></div><!--/$--></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><!--$?--><template id="B:14"></template><div class="ur-code-block"><div class="ur-code-block__header"><div class="ur-code-block__header-left"><span class="ur-code-block__metadata">Python</span></div><div class="ur-code-block__header-right"></div></div><div class="ur-code-block__content"><pre><code>import gradio as gr
import ffmpeg
from faster_whisper import WhisperModel
from TTS.api import TTS
from transformers import pipeline
import subprocess
import os

# 1. Load model 1 lần khi start
whisper = WhisperModel(&quot;medium&quot;, device=&quot;cuda&quot;, compute_type=&quot;float16&quot;) # đổi &quot;small&quot; nếu GPU &lt;6GB
tts = TTS(&quot;tts_models/multilingual/multi-dataset/xtts_v2&quot;).to(&quot;cuda&quot;)
translator = pipeline(&quot;translation&quot;, model=&quot;Helsinki-NLP/opus-mt-en-vi&quot;, device=0) # đổi cặp ngôn ngữ

def process_video(video_path, target_lang):
    output_path = &quot;output_dubbed.mp4&quot;
    audio_path = &quot;temp_audio.wav&quot;

    # B1: Tách audio từ video
    ffmpeg.input(video_path).output(audio_path).run(overwrite_output=True)

    # B2: Whisper tách lời + timestamp
    segments, _ = whisper.transcribe(audio_path, word_timestamps=True)
    full_text = &quot; &quot;.join([seg.text for seg in segments])

    # B3: Dịch văn bản
    if target_lang!= &quot;vi&quot;:
        translated = translator(full_text)[0][&#x27;translation_text&#x27;]
    else:
        translated = full_text # nếu đích là tiếng Việt thì khỏi dịch

    # B4: Clone giọng từ audio gốc + tạo TTS mới
    tts.tts_to_file(text=translated, speaker_wav=audio_path, language=target_lang, file_path=&quot;dub.wav&quot;)

    # B5: Dùng Wav2Lip khớp khẩu hình
    cmd = f&quot;python Wav2Lip/inference.py --checkpoint_path Wav2Lip/checkpoints/wav2lip_gan.pth --face {video_path} --audio dub.wav --outfile {output_path}&quot;
    subprocess.run(cmd, shell=True)

    return output_path, full_text, translated

# Giao diện Gradio
demo = gr.Interface(
    fn=process_video,
    inputs=[gr.Video(label=&quot;Upload Video&quot;), gr.Dropdown([&quot;en&quot;, &quot;vi&quot;, &quot;ja&quot;, &quot;ko&quot;, &quot;zh&quot;], label=&quot;Ngôn ngữ đích&quot;)],
    outputs=[gr.Video(label=&quot;Video đã lồng tiếng&quot;), gr.Textbox(label=&quot;Transcript gốc&quot;), gr.Textbox(label=&quot;Bản dịch&quot;)],
    title=&quot;HeyGen Self-Hosted - 0đ&quot;,
)
demo.launch(share=True)</code></pre></div></div><!--/$--></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div><div dir="auto" class="ur-markdown prose prose-trimmed citation-aware"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"></div></div></div></div></div></div></div><div class="min-w-0"><div class="markdown-content min-w-0"><div class="stack mx-auto flex max-w-3xl min-w-0 flex-col items-center overflow-visible"><div class="min-w-0 w-full"><div class="group/table"><div class="w-full -mt-3"><div class="w-full pb-2"><table class="w-full table-auto"><thead class="bg-color-(--surface-quaternary) border-color-(--fill-divider) border-b-2 border-solid"><tr><th class="text-subheadline text-text-primary py-2 px-4 text-start align-top break-words first:ps-0"><div dir="auto" class="prose [&amp;&gt;div]:mb-0 [&amp;&gt;div]:gap-0 [&amp;_*]:text-subheadline [&amp;_*]:font-semibold"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"><p>Bước</p></div></div></th><th class="text-subheadline text-text-primary py-2 px-4 text-start align-top break-words first:ps-0"><div dir="auto" class="prose [&amp;&gt;div]:mb-0 [&amp;&gt;div]:gap-0 [&amp;_*]:text-subheadline [&amp;_*]:font-semibold"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"><p>Tool</p></div></div></th><th class="text-subheadline text-text-primary py-2 px-4 text-start align-top break-words first:ps-0"><div dir="auto" class="prose [&amp;&gt;div]:mb-0 [&amp;&gt;div]:gap-0 [&amp;_*]:text-subheadline [&amp;_*]:font-semibold"><div class="space-y-4 whitespace-normal [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0 mb-4 flex flex-col gap-6"><p>VRAM cầ